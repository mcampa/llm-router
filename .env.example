# Template for .env - copy to .env and fill in. .env is gitignored.

# --- LiteLLM proxy ---
# Generate with:  echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-<paste-a-long-random-key>
# Generate with:  openssl rand -hex 32
# WARNING: this key encrypts credentials stored in the DB. Changing it later makes
# previously-stored keys unreadable.
LITELLM_SALT_KEY=<paste-a-long-random-key>

# --- DeepSeek cloud API key ---
DEEPSEEK_API_KEY=sk-<your-deepseek-api-key>
